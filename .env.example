
# ==========================================
# Gemini API
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# Application authentication
# ==========================================
# Use "off" for local development.
# Enable authentication for deployed environments.
INVOICE_AUTH=off
INVOICE_AUTH_SECRET=

# ==========================================
# Database
# ==========================================
# Leave empty for local SQLite development.
# Set your PostgreSQL connection URL for cloud deployment.
DATABASE_URL=

# ==========================================
# Frontend -> FastAPI backend
# ==========================================
# Local development default.
# Replace with your deployed FastAPI backend URL in the cloud.
INVOICE_API_URL=http://127.0.0.1:8000

# ==========================================
# Startup recovery
# ==========================================
INVOICE_RECOVERY_ON_START=1
SUBMISSION_RECOVERY_GRACE_SECONDS=0

# ==========================================
# Supabase S3-compatible object storage
# ==========================================
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
